# VoidSINT Backend — copy to .env and fill in values

# PostgreSQL connection string (required for database features)
# Render/Railway will give you this automatically
DATABASE_URL=postgresql://user:password@host:5432/voidsint

# Port for the Express server (default: 3001)
PORT=3001

# Set to "production" when deploying
NODE_ENV=development

# The URL of your frontend (for CORS)
# GitHub Pages example: https://zv3z.github.io
FRONTEND_URL=http://localhost:5173

# Optional: GitHub token for higher-rate GitHub API calls (username investigation)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
